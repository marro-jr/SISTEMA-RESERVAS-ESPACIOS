{
  "name": "sistema-reservas-espacios",
  "version": "1.0.0",
  "description": "Sistema web completo y funcional para reserva de espacios compartidos (salas de reunión, laboratorios, cubículos) desarrollado con Node.js, Express, MySQL y Vanilla JS.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node scripts/initDb.js --test && jest --runInBand --detectOpenHandles --forceExit",
    "db:init": "node scripts/initDb.js",
    "db:init:test": "node scripts/initDb.js --test"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "reservations",
    "rest-api",
    "portfolio"
  ],
  "author": "Jorge",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
